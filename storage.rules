rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // SAMISHA is a personal app without Firebase Authentication.
    // Assignment attachments must be readable by Vidushi and writable by the teacher app.
    match /assignments/{assignmentId}/{fileName} {
      allow read: if true;
      allow write: if request.resource != null
                   && request.resource.size < 50 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*|video/.*|application/pdf|application/msword|application/vnd.openxmlformats-officedocument.wordprocessingml.document');
    }

    // Student-submitted photos use the existing path.
    match /submissions/{assignmentId}/{fileName} {
      allow read: if true;
      allow write: if request.resource != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/jpeg|image/png|image/webp');
    }
  }
}
